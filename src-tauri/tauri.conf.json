{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Code Desktop",
  "version": "0.6.0",
  "identifier": "ai.commandcode.cmdcgui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Command Code Desktop",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "label": "main",
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Logic-k/command-code-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQzc2QzRCRDdBRkY1MDQKUldRRTlhL1hTMnpIVW1LdFNpWi9oSW1xcFJpOEZKNFcweHIxMWJWaS93bGVRbmo1cGtpRS9CSm8K",
      "windows": { "installMode": "passive" }
    }
  }
}
